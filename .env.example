# ==============================================================================
# Environment Configuration - Olympic Archery Arena
# ==============================================================================

# Admin / Operator Security PIN for leaderboard reset
ARCHERY_ADMIN_PIN=2468

# Enable embedded LiDAR UDP listener thread in Flask app (0 = disabled, 1 = enabled)
ARCHERY_LIDAR=0

# Server Port (Default: 5000)
PORT=5000

# Flask Environment (development / production)
FLASK_ENV=production

